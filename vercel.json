{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    },
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/lua-editor/?$",
      "dest": "/index.html"
    },
    {
      "src": "/calculator/?$",
      "dest": "/index.html"
    }
  ]
}
